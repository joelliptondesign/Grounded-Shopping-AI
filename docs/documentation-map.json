{
  "version": 2,
  "rules": [
    {
      "id": "engine",
      "prefixes": [
        "engine/"
      ],
      "docs": [
        "GOVERNANCE.md",
        "docs/ARCHITECTURE.md"
      ]
    },
    {
      "id": "prompts",
      "prefixes": [
        "prompts/"
      ],
      "docs": [
        "GOVERNANCE.md",
        "docs/EVALUATION.md"
      ]
    },
    {
      "id": "api",
      "prefixes": [
        "api/"
      ],
      "docs": [
        "api/README.md"
      ]
    },
    {
      "id": "frontend",
      "prefixes": [
        "frontend/"
      ],
      "docs": [
        "frontend/README.md"
      ]
    },
    {
      "id": "fixtures",
      "prefixes": [
        "fixtures/"
      ],
      "docs": [
        "GOVERNANCE.md",
        "docs/EVALUATION.md"
      ]
    },
    {
      "id": "evaluation",
      "prefixes": [
        "evals/",
        "tests/"
      ],
      "docs": [
        "docs/EVALUATION.md"
      ]
    },
    {
      "id": "benchmarks",
      "prefixes": [
        "bench/",
        "scripts/model_bakeoff.py"
      ],
      "docs": [
        "docs/MODEL_BAKEOFF.md"
      ]
    },
    {
      "id": "fixture-review",
      "prefixes": [
        "scripts/review_",
        "scripts/phase4f_smoke.py"
      ],
      "docs": [
        "docs/EVALUATION.md"
      ]
    },
    {
      "id": "legacy",
      "prefixes": [
        "streamlit_app.py",
        "app.py"
      ],
      "docs": [
        "docs/TECHNICAL_OVERVIEW.md"
      ]
    },
    {
      "id": "setup",
      "prefixes": [
        "requirements",
        "pyproject.toml",
        ".gitignore",
        ".env.example"
      ],
      "docs": [
        "docs/TECHNICAL_OVERVIEW.md"
      ]
    },
    {
      "id": "deployment",
      "prefixes": [
        "vercel.json",
        ".vercelignore",
        ".github/",
        ".githooks/"
      ],
      "docs": [
        "docs/DEPLOYMENT.md"
      ]
    },
    {
      "id": "groundwork",
      "prefixes": [
        "AGENTS.md",
        "CLAUDE.md",
        "scripts/check-docs",
        "scripts/verify-offline.py",
        "scripts/groundwork-tests/",
        "docs/documentation-",
        "docs/workflow/",
        "scripts/groundwork/",
        "scripts/sync-guidance",
        "docs/guidance-map.json",
        ".groundwork/",
        "CLAUDE.md",
        "scripts/sync-guidance",
        "docs/decisions/"
      ],
      "docs": [
        "docs/workflow/README.md"
      ]
    },
    {
      "id": "guidance",
      "prefixes": [
        "docs/",
        "README.md",
        "README-PORTFOLIO.md",
        "GOVERNANCE.md"
      ],
      "docs": [],
      "excludePrefixes": [
        "docs/history/",
        "docs/history/groundwork-migrations/"
      ]
    },
    {
      "id": "historical",
      "prefixes": [
        "artifacts/"
      ],
      "docs": [],
      "historical": true
    },
    {
      "id": "artifact-index",
      "prefixes": [
        "artifacts/evals/INDEX.md"
      ],
      "docs": [
        "docs/EVALUATION.md"
      ]
    },
    {
      "id": "migration-history",
      "prefixes": [
        "docs/history/"
      ],
      "docs": [],
      "historical": true
    },
    {
      "id": "groundwork-managed",
      "prefixes": [
        ".groundwork/",
        "scripts/check-docs.mjs",
        "scripts/sync-guidance.mjs",
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "docs": []
    },
    {
      "id": "groundwork-project-docs",
      "prefixes": [
        "docs/PROJECT-STATE.md",
        "docs/documentation-map.json",
        "docs/documentation-review.json",
        "docs/decisions/",
        "docs/SOURCE-MAP.md",
        "AGENTS.md",
        "docs/workflow/README.md",
        "docs/decisions/README.md",
        "docs/decisions/TEMPLATE.md"
      ],
      "docs": []
    },
    {
      "id": "groundwork-migration-history",
      "prefixes": [
        "docs/history/groundwork-migrations/"
      ],
      "docs": [],
      "historical": true
    }
  ],
  "guidanceMap": "docs/guidance-map.json"
}
